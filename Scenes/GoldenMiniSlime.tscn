[gd_scene format=3]

[ext_resource type="Script" path="res://Scenes/golden_mini_slime.gd" id="1_script"]
[ext_resource type="Texture2D" path="res://assets/Minislimes/MiniSlimeGolden.png" id="1_idle"]
[ext_resource type="Texture2D" path="res://assets/Minislimes/MiniSlimeGolden_ani1.png" id="2_anim"]

[ext_resource type="Texture2D" path="res://assets/Particles/Golden_particles.png" id="3_particles"]
[ext_resource type="AudioStream" path="res://audio/sfx/golden/golden_spawn.wav" id="4_spawn"]
[ext_resource type="AudioStream" path="res://audio/sfx/golden/golden_twinkle.wav" id="5_twinkle"]

[sub_resource type="Gradient" id="Gradient_trail"]
offsets = PackedFloat32Array(0, 0.6, 1)
colors = PackedColorArray(1, 1, 1, 1, 1, 1, 1, 0.8, 1, 1, 1, 0)

[sub_resource type="CanvasItemMaterial" id="CanvasItemMaterial_trail"]
particles_animation = true
particles_anim_h_frames = 3
particles_anim_v_frames = 2
particles_anim_loop = false

[sub_resource type="CircleShape2D" id="CircleShape2D_golden"]
radius = 27.0

[sub_resource type="AtlasTexture" id="AtlasTexture_idle"]
atlas = ExtResource("1_idle")
region = Rect2(0, 0, 80, 80)

[sub_resource type="AtlasTexture" id="AtlasTexture_a0"]
atlas = ExtResource("2_anim")
region = Rect2(0, 0, 80, 80)

[sub_resource type="AtlasTexture" id="AtlasTexture_a1"]
atlas = ExtResource("2_anim")
region = Rect2(80, 0, 80, 80)

[sub_resource type="AtlasTexture" id="AtlasTexture_a2"]
atlas = ExtResource("2_anim")
region = Rect2(160, 0, 80, 80)

[sub_resource type="AtlasTexture" id="AtlasTexture_a3"]
atlas = ExtResource("2_anim")
region = Rect2(0, 80, 80, 80)

[sub_resource type="AtlasTexture" id="AtlasTexture_a4"]
atlas = ExtResource("2_anim")
region = Rect2(80, 80, 80, 80)

[sub_resource type="AtlasTexture" id="AtlasTexture_a5"]
atlas = ExtResource("2_anim")
region = Rect2(160, 80, 80, 80)

[sub_resource type="SpriteFrames" id="SpriteFrames_golden"]
animations = [{
"frames": [{
"duration": 1.0,
"texture": SubResource("AtlasTexture_idle")
}],
"loop": true,
"name": &"idle",
"speed": 5.0
}, {
"frames": [{
"duration": 1.0,
"texture": SubResource("AtlasTexture_a0")
}, {
"duration": 1.0,
"texture": SubResource("AtlasTexture_a1")
}, {
"duration": 1.0,
"texture": SubResource("AtlasTexture_a2")
}, {
"duration": 1.0,
"texture": SubResource("AtlasTexture_a3")
}, {
"duration": 1.0,
"texture": SubResource("AtlasTexture_a4")
}, {
"duration": 1.0,
"texture": SubResource("AtlasTexture_a5")
}],
"loop": false,
"name": &"action",
"speed": 10.0
}]

[node name="GoldenMiniSlime" type="Area2D"]
script = ExtResource("1_script")

[node name="CollisionShape2D" type="CollisionShape2D" parent="."]
position = Vector2(0, 5)
shape = SubResource("CircleShape2D_golden")

[node name="AnimatedSprite2D" type="AnimatedSprite2D" parent="."]
sprite_frames = SubResource("SpriteFrames_golden")
animation = &"idle"

[node name="Timer" type="Timer" parent="."]
wait_time = 3.0
autostart = true

[node name="Trail" type="CPUParticles2D" parent="."]
show_behind_parent = true
texture_filter = 1
material = SubResource("CanvasItemMaterial_trail")
amount = 14
texture = ExtResource("3_particles")
lifetime = 0.9
local_coords = false
direction = Vector2(0, 1)
spread = 180.0
gravity = Vector2(0, 30)
initial_velocity_min = 8.0
initial_velocity_max = 30.0
scale_amount_min = 1.0
scale_amount_max = 1.0
color_ramp = SubResource("Gradient_trail")
anim_offset_max = 0.83

; Aviso de surgimento: não é posicional, para o player ouvir mesmo com o slime longe.
[node name="SpawnSound" type="AudioStreamPlayer" parent="."]
stream = ExtResource("4_spawn")
volume_db = -6.0
bus = &"SFX"

; Brilhinho que toca junto da animação; posicional, então fica mais alto perto do slime.
[node name="TwinkleSound" type="AudioStreamPlayer2D" parent="."]
stream = ExtResource("5_twinkle")
volume_db = -4.0
max_distance = 1800.0
bus = &"SFX"
